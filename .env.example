# ---------------------------------------------------------------------------
# FirstRupee configuration template.
# Copy to backend/.env for local runs (the backend reads that file). Never commit real keys.
# Every value below is optional: the full demo runs with no API keys and no external services.
# ---------------------------------------------------------------------------

# Database. SQLite by default (relative paths are resolved inside backend/).
# PostgreSQL example: postgresql+psycopg://firstrupee:change-me@localhost:5432/firstrupee
DATABASE_URL=sqlite:///./data/firstrupee.db

# Sessions and cookies. Set COOKIE_SECURE=true whenever the site is served over HTTPS.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional language model (OpenAI-compatible chat completions). Leave LLM_PROVIDER=none to use the deterministic engines only.
LLM_PROVIDER=none
# LLM_API_KEY=            (read from the environment only; never hard-code or commit it)
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=25

# Runtime ports used by scripts/start.mjs and the Docker setup.
PORT=3000
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
